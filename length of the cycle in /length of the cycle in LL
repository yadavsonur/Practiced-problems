class Solution {
    public int lengthOfLoop(Node head) {
        // code here
        Node slow = head;
        Node fast = head;
        
        while(fast.next!= null && fast.next.next!=null){
            slow = slow.next;
            fast = fast.next.next;
            if(slow==fast){
                int ct =1;
                fast=fast.next;
        
        while(slow!=fast){
            fast=fast.next;
            ct++;
        }
        return ct;
                
            }
        }
        
        return 0;
    }
}
